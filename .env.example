# Public browser configuration. Use the Supabase anon key, never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Public deployment label. Server-side functions enforce region, safety and entitlements.
VITE_APP_ENV=development

# Operator contact mailboxes shown in Help and Privacy. Leave empty until a real
# address exists; the UI will not invent one. Public invite waits until support is set.
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=

# Optional same-origin client error ingest. Production builds default to
# /ops/client-errors. Leave unset locally to skip network; JSON still goes to
# console.error. Public URL only — never put a webhook secret in VITE_*.
# VITE_ERROR_INGEST_URL=

# Hosted Auth proof. Never put the service-role key in VITE_*. Opt in with:
# MOMENTUM_HOSTED_AUTH_PROOF=1
# SUPABASE_URL=https://osyvvzglvyonevkhdzpu.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Or run `npm run test:auth-hosted` while logged into the Supabase CLI.

# Server-only values belong in Supabase Edge Function secrets, not this file:
# OPENAI_API_KEY
# OPENAI_PLAN_MODEL=replace-with-approved-model
# OPENAI_PLAN_TIMEOUT_MS=180000
# OPENAI_PLAN_MAX_OUTPUT_TOKENS=48000
# AI_PLAN_PROVIDER=stub
# AI_PLAN_LIVE_OPENAI=false
# PAYMENTS_MASTER_ENABLED=false
# IR_PAYMENT_PROVIDER=zarinpal
# INTERNATIONAL_PAYMENT_PROVIDER=stripe
# IPINFO_TOKEN=...
# AI_RESERVATION_MAX_AGE_SECONDS=600

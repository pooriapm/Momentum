# Public browser configuration. Use the Supabase anon key, never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Public deployment label. Server-side functions enforce region, safety and entitlements.
VITE_APP_ENV=development

# Operator contact mailboxes shown in Help and Privacy. Leave empty until a real
# address exists; the UI will not invent one. Public invite waits until support is set.
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=

# Optional same-origin client error ingest. Leave unset to skip network; JSON
# still goes to console.error for browser/Cloudflare logs. Public URL only —
# never put a webhook secret in VITE_*.
# VITE_ERROR_INGEST_URL=

# Server-only values belong in Supabase Edge Function secrets, not this file:
# OPENAI_API_KEY
# OPENAI_PLAN_MODEL=replace-with-approved-model
# AI_PLAN_PROVIDER=stub
# AI_PLAN_LIVE_OPENAI=false
# AI_ENABLED_MARKETS=
# AI_ALLOWED_BILLING_COUNTRIES=...
# IPINFO_TOKEN=...
# AI_RESERVATION_MAX_AGE_SECONDS=600

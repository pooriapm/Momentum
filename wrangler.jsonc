{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "momentum",
  "compatibility_date": "2026-08-03",
  "main": "workers/ops.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "momentumfit.ir", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // The legacy-host redirect lives in the Worker, so it must see asset paths too.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "momentum-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-staging",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash"
      },
      "vars": {
        "MOMENTUM_ENVIRONMENT": "staging"
      }
    }
  }
}

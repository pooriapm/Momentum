{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "momentum",
  "compatibility_date": "2026-08-03",
  "main": "workers/ops.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

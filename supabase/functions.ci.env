ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Local Quality/E2E serves functions with public beta open so randomly created
# fixture users are not blocked. Production defaults stay fail-closed in
# supabase/.env.example.
PUBLIC_BETA_ENABLED=true
ALPHA_ENROLLMENT_ENABLED=false
ALPHA_COHORT_IDS=

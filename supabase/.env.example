# Supabase injects these automatically in hosted Edge Functions. For local
# serving, copy this file outside version control and use local values printed
# by `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Server-only OpenAI configuration. Never prefix these with VITE_ or expose
# them to web/native clients.
# All switches fail closed: every relevant value must be exactly `true`.
AI_MASTER_ENABLED=false
AI_PLAN_ENABLED=false
# Monthly generation provider. Every member's plan, the free first month
# included, comes from the AI provider. The schema-valid stub (no network) is a
# fixed template for local runs and CI only and is refused unless
# AI_PLAN_ALLOW_STUB=true; never set that in production. Country never gates
# plan generation. For a live release set:
#   AI_PLAN_PROVIDER=openai
#   AI_PLAN_LIVE_OPENAI=true
#   OPENAI_API_KEY=...
#   OPENAI_API_BASE_URL=...   (an OpenAI-compatible gateway, if not OpenAI)
#   OPENAI_PLAN_MODEL=...
#   OPENAI_PLAN_REASONING_EFFORT=medium
AI_PLAN_PROVIDER=stub
AI_PLAN_LIVE_OPENAI=false
# OpenAI-compatible provider (production: GapGPT), selected with AI_PLAN_PROVIDER=compatible.
# Simple briefs use LLM_PLAN_MODEL, complex ones (plan-complexity.ts) LLM_PLAN_MODEL_COMPLEX.
# Prices are Toman per 1M tokens (GapGPT USD list x 270,000 Toman/USD on 2026-10-21); a Toman cap
# requires them. Re-price when the dollar rate or the provider's list changes.
#   AI_PLAN_LIVE_LLM=true
#   LLM_API_BASE_URL=https://api.gapgpt.app/v1
#   LLM_API_KEY=...
#   LLM_PLAN_MODEL=gpt-6-luna
#   LLM_REASONING_EFFORT=low
#   LLM_PRICE_TOMAN_PER_1M_INPUT=27000
#   LLM_PRICE_TOMAN_PER_1M_OUTPUT=135000
#   LLM_PLAN_MODEL_COMPLEX=gpt-5.6-luna
#   LLM_COMPLEX_PRICE_TOMAN_PER_1M_INPUT=54000
#   LLM_COMPLEX_PRICE_TOMAN_PER_1M_OUTPUT=324000
#   AI_DAILY_BUDGET_TOMAN=2000000
#   AI_PLAN_MAX_COST_TOMAN=20000
#   PLAN_PIPELINE_BUDGET_MS=130000
#   PLAN_SYNC_WAIT_MS=20000
AI_PLAN_LIVE_LLM=false
AI_PLAN_ALLOW_STUB=false
AI_COACH_ENABLED=false
AI_BODY_COMPOSITION_ENABLED=false
PAYMENTS_MASTER_ENABLED=false
# Checkout routing is deterministic and does not restrict product access.
IR_PAYMENT_PROVIDER=zarinpal
INTERNATIONAL_PAYMENT_PROVIDER=stripe

# Prepaid 30-day membership in IRR: Zarinpal on the website, Cafe Bazaar in the Android app.
# Zarinpal returns land on PUBLIC_SITE_URL/{fa|en}/app/me?payment=success|failed|cancelled.
PUBLIC_SITE_URL=http://localhost:5173
ZARINPAL_MERCHANT_ID=replace-with-merchant-uuid
ZARINPAL_SANDBOX=true
BAZAAR_PACKAGE_NAME=com.pooriapm.momentum
BAZAAR_PRODUCT_ID=membership_month
# Preferred: per-app token from Pishkhan → "API پیشخان بازار" → "دریافت توکن جدید".
# When set, the three legacy OAuth values below are ignored.
BAZAAR_PISHKHAN_API_SECRET=replace-with-pishkhan-api-token
# Legacy fallback (OAuth refresh-token flow), used only without the token above.
BAZAAR_CLIENT_ID=replace-with-pishkhan-client-id
BAZAAR_CLIENT_SECRET=replace-with-pishkhan-client-secret
BAZAAR_REFRESH_TOKEN=replace-with-pishkhan-refresh-token
# BAZAAR_API_BASE_URL=https://pardakht.cafebazaar.ir/devapi/v2
# Card-to-card for Iranian website members: the card shown to payers, reviewed by hand.
PAYMENT_CARD_NUMBER=replace-with-16-digit-card-number
PAYMENT_CARD_HOLDER=replace-with-card-holder-name
# Account ids (comma separated) allowed to approve or reject receipts.
ADMIN_USER_IDS=replace-with-admin-user-uuid
PAYMENTS_RATE_LIMIT=20
PAYMENTS_RATE_WINDOW_SECONDS=3600
ALPHA_ENROLLMENT_ENABLED=false
ALPHA_COHORT_IDS=
PUBLIC_BETA_ENABLED=false
AI_MAX_REQUESTS_PER_DAY=1000
AI_CIRCUIT_WINDOW_SECONDS=86400
CURRENT_TERMS_VERSION=2026-08-01-alpha
CURRENT_PRIVACY_VERSION=2026-08-01-alpha
CURRENT_HEALTH_CONSENT_VERSION=2026-08-01-alpha
OPENAI_API_KEY=replace-with-server-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PLAN_MODEL=replace-with-approved-model
OPENAI_PLAN_REASONING_EFFORT=medium
OPENAI_PLAN_TIMEOUT_MS=180000
OPENAI_PLAN_MAX_OUTPUT_TOKENS=48000
OPENAI_SAFETY_PEPPER=replace-with-at-least-32-random-bytes
# OPENAI_PROJECT=
# OPENAI_ORGANIZATION=

# Comma-separated exact origins. Native clients normally omit Origin.
ALLOWED_ORIGINS=http://localhost:5173
IPINFO_TOKEN=
AI_RESERVATION_MAX_AGE_SECONDS=600

PLAN_RATE_LIMIT=3
PLAN_RATE_WINDOW_SECONDS=3600
COACH_RATE_LIMIT=20
COACH_RATE_WINDOW_SECONDS=3600
ACCOUNT_DATA_RATE_LIMIT=120
ACCOUNT_DATA_RATE_WINDOW_SECONDS=3600
BODY_ANALYSIS_RATE_LIMIT=3
BODY_ANALYSIS_RATE_WINDOW_SECONDS=3600

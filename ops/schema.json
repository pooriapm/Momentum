{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momentum.local/schemas/operations-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "service",
    "backup",
    "restoreDrill",
    "monitoring",
    "alerts",
    "oncall",
    "support"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "service": { "const": "momentum" },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "projectRef",
        "dailyBackupRequired",
        "pitrRequired",
        "pitrRetentionDays",
        "rpoHoursOrdinary",
        "rpoHoursPaidTransactions",
        "rtoHours",
        "hostedRestoreTarget",
        "hostedRestoreStatus"
      ],
      "properties": {
        "provider": { "const": "supabase" },
        "projectRef": { "type": "string", "minLength": 8, "maxLength": 40 },
        "dailyBackupRequired": { "type": "boolean" },
        "pitrRequired": { "type": "boolean" },
        "pitrRetentionDays": { "type": "integer", "minimum": 7 },
        "rpoHoursOrdinary": { "type": "number", "minimum": 1 },
        "rpoHoursPaidTransactions": { "type": "number", "minimum": 1 },
        "rtoHours": { "type": "number", "minimum": 1 },
        "hostedRestoreTarget": { "enum": ["staging"] },
        "hostedRestoreStatus": { "enum": ["blocked_no_staging", "rehearsed", "verified"] }
      }
    },
    "restoreDrill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "cadence", "evidenceDir", "neverProductionDump", "localModes"],
      "properties": {
        "script": { "const": "scripts/ops/restore-drill.sh" },
        "cadence": { "const": "before_launch_then_quarterly" },
        "evidenceDir": { "const": "artifacts/restore-drills" },
        "neverProductionDump": { "const": true },
        "localModes": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["dry-run", "execute"] }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthPath",
        "errorIngestPath",
        "allowedErrorCodes",
        "forbiddenFields",
        "signals"
      ],
      "properties": {
        "healthPath": { "const": "/ops/health" },
        "errorIngestPath": { "const": "/ops/client-errors" },
        "allowedErrorCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "forbiddenFields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "signals": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        }
      }
    },
    "alerts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "ownerRole", "condition", "page"],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 80 },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "ownerRole": { "type": "string", "minLength": 3, "maxLength": 80 },
          "condition": { "type": "string", "minLength": 8, "maxLength": 240 },
          "page": { "type": "boolean" }
        }
      }
    },
    "oncall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryRole", "contactEnv", "ackMinutes", "roles", "escalation"],
      "properties": {
        "primaryRole": { "type": "string", "minLength": 3, "maxLength": 80 },
        "contactEnv": { "const": "MOMENTUM_ONCALL_CONTACT" },
        "ackMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P0", "P1", "P2"],
          "properties": {
            "P0": { "type": "integer", "minimum": 1, "maximum": 30 },
            "P1": { "type": "integer", "minimum": 5, "maximum": 180 },
            "P2": { "type": "integer", "minimum": 30, "maximum": 1440 }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "escalation": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locales",
        "macrosFile",
        "responseTargetHours",
        "mailboxEnv",
        "privacyMailboxEnv"
      ],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["fa", "en"] },
          "uniqueItems": true
        },
        "macrosFile": { "const": "ops/support-macros.json" },
        "responseTargetHours": { "type": "integer", "minimum": 1, "maximum": 72 },
        "mailboxEnv": { "const": "VITE_SUPPORT_EMAIL" },
        "privacyMailboxEnv": { "const": "VITE_PRIVACY_EMAIL" }
      }
    }
  }
}
